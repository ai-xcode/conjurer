# conjurer/.env.example — copy this to `.env` and fill in your own values.
#
# DO NOT commit your filled-in `.env` — it's already in .gitignore.
# Permissions: chmod 600 .env  (owner-only read).
#
# ────────── DeepSeek (cloud LLM fallback when local vLLM is offline) ──────────
# Get a key at https://platform.deepseek.com/api_keys — paste it below.
# Conjurer never sends this key anywhere except api.deepseek.com (HTTPS).
DEEPSEEK_API_KEY=

# ────────── (optional) override the default vLLM tier ─────────────────────────
# If you have a local vLLM server, point Conjurer at it. OpenAI-compatible.
# VLLM_BASE_URL=http://127.0.0.1:8001/v1

# ────────── (optional) any other supported provider ───────────────────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
