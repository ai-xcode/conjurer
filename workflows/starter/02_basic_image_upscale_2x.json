{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "example.png"
    }
  },
  "2": {
    "class_type": "UpscaleModelLoader",
    "inputs": {
      "model_name": "<replace-with-your-upscaler.pth>"
    }
  },
  "3": {
